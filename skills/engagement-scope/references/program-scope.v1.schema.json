{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://program-scope.local/schemas/program-scope.v1.schema.json",
  "title": "Program Scope Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program_id",
    "name",
    "owner",
    "platform",
    "program_type",
    "scope_model",
    "official_urls",
    "source_records",
    "safe_harbor",
    "testing_limits",
    "last_verified",
    "cache_policy",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "program-scope.v1"
    },
    "program_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./_-]*[a-z0-9]$"
    },
    "parent_program_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./_-]*[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "enum": [
        "direct",
        "hackerone",
        "bugcrowd",
        "intigriti",
        "yeswehack",
        "other"
      ]
    },
    "platform_handle": {
      "type": "string",
      "minLength": 1
    },
    "program_type": {
      "type": "string",
      "enum": [
        "direct",
        "platform"
      ]
    },
    "scope_model": {
      "type": "string",
      "enum": [
        "listed-assets",
        "product-family",
        "open-with-exclusions",
        "mixed",
        "unknown"
      ]
    },
    "official_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9./_-]*\\.ya?ml$"
      }
    },
    "subrecords": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "path",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*[a-z0-9]$"
          },
          "type": {
            "type": "string",
            "enum": [
              "product",
              "product-group",
              "subprogram",
              "subprogram-group"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9./_-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "safe_harbor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "urls",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "documented",
            "linked",
            "unknown",
            "none"
          ]
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "testing_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "cache_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ttl_seconds",
        "refresh_required_before_testing"
      ],
      "properties": {
        "ttl_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "refresh_required_before_testing": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
